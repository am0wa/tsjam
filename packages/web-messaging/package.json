{
  "name": "@tsjam/web-messaging",
  "version": "0.3.1",
  "description": "Reactive Post message host",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b src/tsconfig.json",
    "lint": "eslint src",
    "test": "echo tests",
    "clean:dist": "rimraf lib",
    "prepublishOnly": "pnpm run clean:dist && pnpm run build && pnpm run test"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tsconfig.json",
    "!**/tsconfig.tsbuildinfo"
  ],
  "keywords": [
    "post message host"
  ],
  "author": "am0wa",
  "license": "ISC",
  "homepage": "https://github.com/am0wa/tsjam#readme",
  "devDependencies": {
    "tsjam": "workspace:^",
    "typescript7": "catalog:"
  },
  "peerDependencies": {
    "rxjs": "^7.x",
    "tsjam": ">=1.9.2 || >=2.0.0-0"
  }
}
